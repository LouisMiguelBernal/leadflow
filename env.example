# Copy this file yourself to `.env` in this folder, then fill in the blanks.
#   PowerShell:  Copy-Item env.example .env

# --- Postgres -------------------------------------------------------------
POSTGRES_PASSWORD=leadflow_dev
# From the host (psql, the agent run via npm):      localhost:5434
# From inside a container (an n8n Postgres node):   postgres:5432
DATABASE_URL=postgres://leadflow:leadflow_dev@localhost:5434/leadflow

# --- n8n ------------------------------------------------------------------
# Must stay constant across restarts, or saved credentials stop decrypting.
N8N_ENCRYPTION_KEY=dev-only-change-me

# --- Anthropic ------------------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Stripe (test mode) ---------------------------------------------------
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Printed by `stripe listen`. Not the dashboard endpoint's secret.
STRIPE_WEBHOOK_SECRET=

AGENT_PORT=4000
